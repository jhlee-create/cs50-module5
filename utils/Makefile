# Makefile -- build the reusable data-structure, webpage, and file-I/O library.

CC=gcc
CPPFLAGS=-I.
CFLAGS=-Wall -pedantic -std=c11 -g
OFILES=queue.o hash.o webpage.o pageio.o indexio.o
LIBDIR=../lib
LIBRARY=$(LIBDIR)/libutils.a

.PHONY: all clean

# Compile every utility module and archive the objects into one library.
all: $(LIBRARY)

$(LIBRARY): $(OFILES) | $(LIBDIR)
	ar cr $(LIBRARY) $(OFILES)

# Create the library directory when this Makefile is used independently.
$(LIBDIR):
	mkdir -p $(LIBDIR)

# Recompile a module whenever its source or public interface changes.
%.o: %.c %.h
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

# The hash implementation also calls functions from the queue interface.
hash.o: queue.h

# Page files contain webpage objects, and index I/O uses hash and queue modules.
pageio.o: webpage.h
indexio.o: hash.h queue.h

# Remove only files generated by this Makefile.
clean:
	rm -f $(OFILES) $(LIBRARY)
